{
  "name": "veyro-web",
  "private": true,
  "version": "0.1.0",
  "description": "Veyro web surfaces: Admin, Member, Coach, Front Desk & POS, Internal Console.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "tokens": "node src/design/generate.mjs",
    "tokens:check": "node src/design/generate.mjs --check",
    "test:foundation": "node --test tests/unit/",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "audit:ci": "npm audit --audit-level=high",
    "verify": "npm run tokens:check && npm run test:foundation && npm run typecheck && npm run test",
    "api": "node tests/e2e/serve.mjs",
    "fixture": "node tests/e2e/fixture.mjs",
    "e2e:nojs": "node tests/e2e/no-js-signin.mjs",
    "e2e:mutate": "node tests/e2e/mutate.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
