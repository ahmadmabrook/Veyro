#!/bin/sh
# Fixed launcher, installed as /usr/local/libexec/veyro-ctl (root:wheel 0755) and run by sudo as the worker account.
# Sterile environment, absolute interpreter, isolated mode; caller arguments pass through untouched as "$@" and are never
# interpolated into anything else.
exec /usr/bin/env -i \
  HOME=/Users/veyroworker USER=veyroworker LOGNAME=veyroworker \
  PATH=/Library/Developer/CommandLineTools/usr/bin:/usr/bin:/bin:/usr/sbin:/sbin \
  /Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/bin/python3.9 -I -S -B \
  "/Library/Application Support/Veyro/release-v2-ctl1/runner/control.py" "$@"
