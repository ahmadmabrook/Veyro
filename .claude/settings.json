{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(shasum*)",
      "Bash(find*)",
      "Bash(ls*)",
      "Read"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(*production*)",
      "Bash(*prod deploy*)",
      "Bash(*--prod*)",
      "Bash(testsprite test run*)",
      "Bash(testsprite test rerun*)",
      "Bash(testsprite testlist run*)",
      "Edit(Gym_OS_Master_Product_Blueprint_v1_English.docx)",
      "Edit(Veyro_Technical_System_Design_v1.4.1_English_FINAL.docx)",
      "Edit(Veyro_Engineering_Implementation_Plan_v1.4.1_English_FINAL_APPROVED_GOVERNING_BASELINE.docx)",
      "Edit(veyro-product-experience-design/**)",
      "Write(Gym_OS_Master_Product_Blueprint_v1_English.docx)",
      "Write(Veyro_Technical_System_Design_v1.4.1_English_FINAL.docx)",
      "Write(Veyro_Engineering_Implementation_Plan_v1.4.1_English_FINAL_APPROVED_GOVERNING_BASELINE.docx)",
      "Write(veyro-product-experience-design/**)",
      "Bash(rm * Gym_OS_Master_Product_Blueprint_v1_English.docx*)",
      "Bash(rm * Veyro_Technical_System_Design_v1.4.1_English_FINAL.docx*)",
      "Bash(rm * Veyro_Engineering_Implementation_Plan_v1.4.1_English_FINAL_APPROVED_GOVERNING_BASELINE.docx*)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat <<'EOF'\n{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"Veyro MOD-000 control plane active. Before any action: read knowledge/00-System/SESSION_BOOTSTRAP.md, then CURRENT_STATE.md and CURRENT_HANDOFF.md. WIP=1, MOD-000 only until a Module Approval Certificate exists.\"}}\nEOF",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
